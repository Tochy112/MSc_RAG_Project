# Copy this file to .env in the repo root before running docker compose

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Mongo (used by docker-compose, defaults match the compose service)
MONGO_URI=mongodb://mongodb:27017/lunozart_rag

# Qdrant (used by docker-compose, defaults match the compose service)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=lunozart_chunks

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_DENSE=8
TOP_K_BM25=8
TOP_K_FUSED=5
RRF_K=60


JWT_SECRET=your_jwt_secret_here

ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Backend port
PORT=4000
